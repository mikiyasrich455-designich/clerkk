{
  "version": 2,
  "functions": {
    "backend.py": {
      "maxDuration": 60
    }
  },
  "builds": [
    { "src": "backend.py", "use": "@vercel/python" },
    { "src": "index.html", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "backend.py" },
    { "src": "/", "dest": "/index.html" },
    { "src": "/index.html", "dest": "/index.html" }
  ]
}
